# Server
PORT=3001

# Class PostgreSQL setup = trust auth (no password). Set the port you chose
# for PGPORT in the class setup (e.g. 8888). No username/password needed; it
# uses your OS user via trust. Create the DB with: createdb culinary
DATABASE_URL=postgresql://localhost:8888/culinary
# Read-only connection used by execute_read_only_sql(). Same DB for now; the
# dedicated read-only role is added in a later phase.
DATABASE_READONLY_URL=postgresql://localhost:8888/culinary

GEMINI_API_KEY=your-gemini-api-key
GEMINI_MODEL=gemini-2.5-flash
